# AI Health Manager - 环境配置示例

# 应用配置
APP_NAME=AI Health Manager
DEBUG=true
API_PREFIX=/api/v1

# 数据库配置
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/health_db
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/health_db

# Redis配置
REDIS_URL=redis://localhost:6379/0

# JWT配置 (生产环境请修改)
SECRET_KEY=change-this-to-a-secure-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# DeepSeek API配置 (可选，未配置时使用Mock)
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# Stable Diffusion配置 (可选)
SD_API_URL=http://localhost:7860

# MinIO配置 (可选)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=health-images

# 异常阈值配置
THRESHOLD_BP_SYS=140.0
THRESHOLD_BP_DIA=90.0
THRESHOLD_FASTING_GLUCOSE=7.0
THRESHOLD_URIC_ACID=420.0
